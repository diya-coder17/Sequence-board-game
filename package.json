{
  "name": "sequence-online",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "SEQUENCE_PORT=3001 tsx watch server/index.ts",
    "dev:all": "concurrently -k -n web,server -c cyan,magenta \"npm:dev\" \"npm:server\"",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json",
    "test-player": "tsx scripts/test-player.ts",
    "start:build": "npm run build && tsx server/index.ts"
  },
  "dependencies": {
    "framer-motion": "^14.14.0",
    "mongodb": "^7.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
